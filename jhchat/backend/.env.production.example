# 生产环境配置示例
# 复制此文件为 .env.production 并修改相应值

# 应用环境
NODE_ENV=production

# 服务器配置
PORT=3001

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=jhchat_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_NAME=jhchat
DB_POOL_MAX=20

# JWT 配置
# 使用 openssl rand -hex 32 生成随机密钥
JWT_SECRET=YOUR_256_BIT_SECRET_HERE
JWT_EXPIRES_IN=7d

# Redis 配置（可选，用于缓存和 Socket.IO adapter）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# 前端配置
FRONTEND_URL=https://your-domain.com

# CORS 配置
CORS_ORIGIN=https://your-domain.com

# 文件上传配置
UPLOAD_DIR=uploads/avatars
MAX_FILE_SIZE=5242880

# 日志配置
LOG_LEVEL=info
LOG_DIR=logs

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 安全配置
BCRYPT_ROUNDS=10
SESSION_TIMEOUT=604800000
